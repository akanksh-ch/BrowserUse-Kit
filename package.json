{
  "name": "browseruse-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p frontend/tsconfig.json",
    "bootstrap": "tsx src/server.ts bootstrap",
    "test": "tsx --test tests/*.test.ts",
    "test:runtime": "python3 scripts/test-runtime.py",
    "check": "npm run typecheck && npm test && npm run test:runtime",
    "build": "vite build",
    "dev:ui": "vite"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@novnc/novnc": "1.7.0",
    "@radix-ui/react-slot": "^1.5.0",
    "chrome-devtools-mcp": "0.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.4"
  }
}
