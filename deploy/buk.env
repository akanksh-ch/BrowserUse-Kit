# Shell-compatible; source with `set -a; . ./deploy/buk.env; set +a`.
# Replace both exact hosts together with the Caddyfile site name. No scheme,
# paths, wildcards, whitespace, or internal localhost authorities here.
BUK_HOSTS=buk.example.com,buk.example.com:443
BUK_SECURE=1
BUK_BIND=127.0.0.1
PORT=3000
BUK_DATABASE=data/control.sqlite
