# Replace buk.example.com here AND in buk.env before deployment.
buk.example.com {
	# Reject unexpected authority values rather than rewriting Host to an allowed one.
	@unexpected expression `{http.request.hostport} != "buk.example.com" && {http.request.hostport} != "buk.example.com:443"`
	respond @unexpected 421

	reverse_proxy 127.0.0.1:3000 {
		# Preserve external Host/Origin for Node's exact host and viewer-origin checks.
		# Native WebSocket upgrades; immediate flush for MCP HTTP/SSE streaming.
		flush_interval -1
	}
}
